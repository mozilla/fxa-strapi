{
  "kind": "collectionType",
  "collectionName": "iaps",
  "info": {
    "singularName": "iap",
    "pluralName": "iaps",
    "displayName": "IAP",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "internalName": {
      "type": "string",
      "required": false,
      "unique": false
    },
    "storeID": {
      "type": "string",
      "unique": true,
      "required": true
    },
    "interval": {
      "type": "enumeration",
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "halfyearly",
        "yearly"
      ],
      "required": true
    },
    "offering": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::offering.offering",
      "inversedBy": "iaps"
    }
  }
}
