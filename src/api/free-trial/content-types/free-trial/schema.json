{
  "kind": "collectionType",
  "collectionName": "free_trials",
  "info": {
    "singularName": "free-trial",
    "pluralName": "free-trials",
    "displayName": "Free Trial"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "internalName": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "required": true,
      "unique": true
    },
    "intervals": {
      "type": "customField",
      "customField": "plugin::multi-select.multi-select",
      "required": true,
      "options": [
        "daily",
        "weekly",
        "monthly",
        "halfyearly",
        "yearly"
      ]
    },
    "trialLengthDays": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "required": true,
      "min": 1
    },
    "countries": {
      "type": "customField",
      "customField": "plugin::multi-select.multi-select",
      "required": true,
      "options": [
        "AT - Austria",
        "BE - Belgium",
        "BG - Bulgaria",
        "CA - Canada",
        "HR - Croatia",
        "CY - Cyprus",
        "CZ - Czech Republic",
        "DK - Denmark",
        "EE - Estonia",
        "FI - Finland",
        "FR - France",
        "DE - Germany",
        "GR - Greece",
        "HU - Hungary",
        "IE - Ireland",
        "IT - Italy",
        "LV - Latvia",
        "LT - Lithuania",
        "LU - Luxembourg",
        "MY - Malaysia",
        "MT - Malta",
        "NL - Netherlands",
        "NZ - New Zealand",
        "PL - Poland",
        "PT - Portugal",
        "RO - Romania",
        "SG - Singapore",
        "SK - Slovakia",
        "SI - Slovenia",
        "ES - Spain",
        "SE - Sweden",
        "CH - Switzerland",
        "GB - United Kingdom",
        "US - United States"
      ]
    },
    "cooldownPeriodMonths": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "required": true
    },
    "offerings": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::offering.offering",
      "inversedBy": "free_trials"
    }
  }
}
