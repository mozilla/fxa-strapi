{
  "kind": "collectionType",
  "collectionName": "free_trials",
  "info": {
    "singularName": "free-trial",
    "pluralName": "free-trials",
    "displayName": "Free Trial"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "internalName": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "required": true,
      "unique": true
    },
    "intervals": {
      "type": "customField",
      "customField": "plugin::multi-select.multi-select",
      "required": true,
      "options": [
        "daily",
        "weekly",
        "monthly",
        "halfyearly",
        "yearly"
      ]
    },
    "trialLengthDays": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "required": true,
      "min": 1
    },
    "countries": {
      "type": "customField",
      "customField": "plugin::multi-select.multi-select",
      "required": true,
      "options": [
        "AT",
        "BE",
        "BG",
        "CA",
        "HR",
        "CY",
        "CZ",
        "DK",
        "EE",
        "FI",
        "FR",
        "DE",
        "GR",
        "HU",
        "IE",
        "IT",
        "LV",
        "LT",
        "LU",
        "MY",
        "MT",
        "NL",
        "NZ",
        "PL",
        "PT",
        "RO",
        "SG",
        "SK",
        "SI",
        "ES",
        "SE",
        "CH",
        "GB",
        "US"
      ]
    },
    "cooldownPeriodMonths": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "required": true
    },
    "offerings": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::offering.offering",
      "inversedBy": "free_trials"
    }
  }
}
