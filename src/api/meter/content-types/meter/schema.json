{
  "kind": "collectionType",
  "collectionName": "meters",
  "info": {
    "singularName": "meter",
    "pluralName": "meters",
    "displayName": "Meter"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "string",
      "required": true,
      "unique": true,
      "regex": "^[a-z0-9]+([_-][a-z0-9]+)*$"
    },
    "unit": {
      "type": "string",
      "required": true
    },
    "limit": {
      "type": "biginteger",
      "required": true
    },
    "windowKind": {
      "type": "enumeration",
      "required": true,
      "default": "calendar",
      "enum": [
        "calendar",
        "sliding",
        "session"
      ]
    },
    "windowPeriod": {
      "type": "enumeration",
      "enum": [
        "daily",
        "weekly",
        "monthly"
      ],
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "windowKind"
            },
            "calendar"
          ]
        }
      }
    },
    "windowDurationMinutes": {
      "type": "integer",
      "min": 1,
      "conditions": {
        "visible": {
          "or": [
            {
              "==": [
                {
                  "var": "windowKind"
                },
                "sliding"
              ]
            },
            {
              "==": [
                {
                  "var": "windowKind"
                },
                "session"
              ]
            }
          ]
        }
      }
    },
    "notificationThresholds": {
      "type": "text"
    },
    "webhooks": {
      "type": "component",
      "component": "entitlements.webhooks",
      "repeatable": true
    }
  }
}
